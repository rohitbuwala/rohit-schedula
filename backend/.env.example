DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-private-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
PORT=5000
# Razorpay Credentials (required for payments)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Medrella Care <notifications@your-verified-domain.example>
# Local integration: mode=test requires a sink address; all recipients are redirected to it.
# Automated test processes never send, even if production credentials are present.
EMAIL_DELIVERY_MODE=disabled
EMAIL_TEST_RECIPIENT=qa@example.invalid
# Set EMAIL_DELIVERY_MODE=production only in the production backend environment.
# Optional observability credentials; leave unset to disable telemetry.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
# Optional assistant configuration. Set both on the backend to enable chat.
# GEMINI_API_KEY=your_server_only_key
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TIMEOUT_MS=20000
# Optional backend-only key for assistant voice transcription.
# SARVAM_API_KEY=your_server_only_key
